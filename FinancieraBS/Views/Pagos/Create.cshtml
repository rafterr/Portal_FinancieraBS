@model BusinessType.Pago

@{
    ViewData["Title"] = "Registrar Pago";
}

<div class="container mt-4">
    <h2>Registrar Pago</h2>

    <form asp-action="Create" method="post" class="mt-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" name="volverADetalle" value="@(ViewBag.VolverADetalle == true ? "true" : "false")" />

        <div class="row">
            <div class="col-md-8 mb-3">
                <label asp-for="PrestamoId" class="form-label"></label>
                <select asp-for="PrestamoId" class="form-select" asp-items="ViewBag.Prestamos">
                    <option value="">Seleccione un préstamo</option>
                </select>
                <span asp-validation-for="PrestamoId" class="text-danger"></span>
                <small class="text-muted">Solo se muestran préstamos con saldo pendiente. El cliente se toma del préstamo.</small>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="MontoPago" class="form-label"></label>
                <input asp-for="MontoPago" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="MontoPago" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Registrar Pago</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
