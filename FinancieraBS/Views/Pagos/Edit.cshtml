@model BusinessType.Pago

@{
    ViewData["Title"] = "Editar Pago";
}

<div class="container mt-4">
    <h2>Editar Pago</h2>
    
    <form asp-action="Edit" method="post" class="mt-4">
        <input type="hidden" asp-for="Id" />
        
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="PrestamoId" class="form-label">Préstamo</label>
                <select asp-for="PrestamoId" class="form-select" asp-items="ViewBag.Prestamos" required>
                    <option value="">Seleccione un préstamo</option>
                </select>
            </div>
            
            <div class="col-md-6 mb-3">
                <label asp-for="ClienteId" class="form-label">Cliente</label>
                <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.Clientes" required>
                    <option value="">Seleccione un cliente</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="MontoPago" class="form-label">Monto del Pago</label>
                <input asp-for="MontoPago" type="number" step="0.01" class="form-control" required />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="FechaPago" class="form-label">Fecha del Pago</label>
                <input asp-for="FechaPago" type="datetime-local" class="form-control" required />
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Actualizar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
