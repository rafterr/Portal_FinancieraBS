@model BusinessType.Pago

@{
    ViewData["Title"] = "Editar Pago";
}

<div class="container mt-4">
    <h2>Editar Pago</h2>

    <form asp-action="Edit" method="post" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="PrestamoId" class="form-label"></label>
                <select asp-for="PrestamoId" class="form-select" asp-items="ViewBag.Prestamos"></select>
                <span asp-validation-for="PrestamoId" class="text-danger"></span>
            </div>

            <div class="col-md-3 mb-3">
                <label asp-for="MontoPago" class="form-label"></label>
                <input asp-for="MontoPago" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="MontoPago" class="text-danger"></span>
            </div>

            <div class="col-md-3 mb-3">
                <label asp-for="FechaPago" class="form-label"></label>
                <input asp-for="FechaPago" type="datetime-local" class="form-control" />
            </div>
        </div>
        <small class="text-muted">Al guardar se recalcula el saldo del préstamo.</small>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Actualizar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
