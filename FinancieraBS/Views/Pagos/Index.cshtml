@model FinancieraBS.Models.PagosIndexViewModel

@{
    ViewData["Title"] = "Pagos";
    var hoy = DateTime.Today;
    var inicioSemana = hoy.AddDays(-(((int)hoy.DayOfWeek + 6) % 7)); // lunes
    var inicioMes = new DateTime(hoy.Year, hoy.Month, 1);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Historial de Pagos</h2>
        <a asp-action="Create" class="btn btn-primary">Registrar Pago</a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-2" role="search">
        @if (Model.PrestamoId.HasValue)
        {
            <input type="hidden" name="prestamoId" value="@Model.PrestamoId" />
        }
        <div class="col-md-5">
            <label class="form-label small mb-0" for="q">Cliente o #préstamo</label>
            <input type="search" id="q" name="q" value="@Model.Q" class="form-control" placeholder="Nombre, teléfono, correo o #12" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-0" for="desde">Desde</label>
            <input type="date" id="desde" name="desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-0" for="hasta">Hasta</label>
            <input type="date" id="hasta" name="hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Filtrar</button>
            @if (Model.HayFiltros)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </form>

    <div class="mb-3 small">
        Atajos:
        <a asp-action="Index" asp-route-desde="@hoy.ToString("yyyy-MM-dd")" asp-route-hasta="@hoy.ToString("yyyy-MM-dd")">Hoy</a> ·
        <a asp-action="Index" asp-route-desde="@inicioSemana.ToString("yyyy-MM-dd")" asp-route-hasta="@hoy.ToString("yyyy-MM-dd")">Esta semana</a> ·
        <a asp-action="Index" asp-route-desde="@inicioMes.ToString("yyyy-MM-dd")" asp-route-hasta="@hoy.ToString("yyyy-MM-dd")">Este mes</a>
    </div>

    <div class="alert alert-info d-flex flex-wrap justify-content-between">
        <span>
            @if (Model.PrestamoId.HasValue)
            {
<text>Pagos del <a asp-controller="Prestamos" asp-action="Detalle" asp-route-id="@Model.PrestamoId">préstamo #@Model.PrestamoId</a></text>
            }
            else if (Model.HayFiltros)
            {
<text>Pagos filtrados</text>
            }
            else
            {
<text>Todos los pagos</text>
            }
            @if (Model.Desde.HasValue || Model.Hasta.HasValue)
            {
                <text> del @(Model.Desde?.ToString("dd/MM/yyyy") ?? "inicio") al @(Model.Hasta?.ToString("dd/MM/yyyy") ?? "hoy")</text>
            }
<text>: <strong>@Model.Pagos.Count</strong> pago(s)</text>
        </span>
        <span>Total cobrado: <strong>$@Model.Total.ToString("N2")</strong></span>
    </div>

    @if (Model.Pagos.Count == 0)
    {
        <div class="alert alert-light border">No se encontraron pagos.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Préstamo</th>
                        <th>Cliente</th>
                        <th class="text-end">Monto</th>
                        <th>Registró</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pago in Model.Pagos)
                    {
                        <tr>
                            <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><a asp-controller="Prestamos" asp-action="Detalle" asp-route-id="@pago.PrestamoId">#@pago.PrestamoId</a></td>
                            <td>@(pago.Cliente?.NombreCompleto ?? "N/A")</td>
                            <td class="text-end">$@pago.MontoPago.ToString("N2")</td>
                            <td>@(pago.Usuario?.Email ?? "—")</td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@pago.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@pago.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
