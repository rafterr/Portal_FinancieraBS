@model FinancieraBS.Models.DocumentosViewModel

<div class="card mt-4">
    <div class="card-header bg-info text-white">Documentos</div>
    <div class="card-body">
        @if (Model.Documentos.Count == 0)
        {
            <p class="text-muted">No hay documentos cargados.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Archivo</th>
                            <th>Préstamo</th>
                            <th>Cargado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documentos)
                        {
                            <tr>
                                <td>@Html.DisplayFor(_ => doc.Tipo)</td>
                                <td>@doc.NombreOriginal <small class="text-muted">(@((doc.Tamano / 1024.0).ToString("N0")) KB)</small></td>
                                <td>@(doc.PrestamoId.HasValue ? $"#{doc.PrestamoId}" : "—")</td>
                                <td>@doc.FechaCarga.ToString("dd/MM/yyyy HH:mm") <small class="text-muted">@doc.Usuario?.Email</small></td>
                                <td class="text-end text-nowrap">
                                    <a asp-controller="Documentos" asp-action="Ver" asp-route-id="@doc.Id" target="_blank" class="btn btn-sm btn-outline-primary">Ver</a>
                                    <a asp-controller="Documentos" asp-action="Ver" asp-route-id="@doc.Id" asp-route-descargar="true" class="btn btn-sm btn-outline-secondary">Descargar</a>
                                    @if (User.IsInRole(BusinessType.Roles.Admin))
                                    {
                                        <form asp-controller="Documentos" asp-action="Eliminar" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este documento?');">
                                            <input type="hidden" name="id" value="@doc.Id" />
                                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.TiposPermitidos.Length > 0)
        {
            <form asp-controller="Documentos" asp-action="Subir" method="post" enctype="multipart/form-data" class="row g-2 align-items-end mt-2">
                <input type="hidden" name="clienteId" value="@Model.ClienteId" />
                <input type="hidden" name="prestamoId" value="@Model.PrestamoId" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <div class="col-md-4">
                    <label class="form-label">Tipo</label>
                    <select name="tipo" class="form-select">
                        @foreach (var tipo in Model.TiposPermitidos)
                        {
                            <option value="@tipo">@Html.DisplayFor(_ => tipo)</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Archivo</label>
                    <input type="file" name="archivo" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Subir</button>
                </div>
                <small class="text-muted">PDF, JPG o PNG, máximo 5 MB. Si ya existe un documento del mismo tipo, se reemplaza.</small>
            </form>
        }
    </div>
</div>
