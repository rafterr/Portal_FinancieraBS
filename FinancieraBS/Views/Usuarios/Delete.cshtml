@model BusinessInterfase.UsuarioConRol

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<div class="container mt-4">
    <h2>Eliminar Usuario</h2>
    <div class="alert alert-danger mt-4">
        <h4>¿Está seguro de eliminar este usuario?</h4>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Usuario.Email</dd>

                <dt class="col-sm-3">Teléfono</dt>
                <dd class="col-sm-9">@Model.Usuario.PhoneNumber</dd>

                <dt class="col-sm-3">Rol</dt>
                <dd class="col-sm-9">@(Model.Rol ?? "Sin rol")</dd>

                <dt class="col-sm-3">Fecha Creación</dt>
                <dd class="col-sm-9">@Model.Usuario.FechaCreacion.ToString("dd/MM/yyyy")</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Usuario.Id" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
