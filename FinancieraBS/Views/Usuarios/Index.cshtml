@model List<BusinessInterfase.UsuarioConRol>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Usuarios</h2>
        <a asp-action="Create" class="btn btn-primary">Nuevo Usuario</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Rol</th>
                    <th>Fecha Creación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var usuario = item.Usuario;
                    var bloqueado = usuario.LockoutEnd.HasValue && usuario.LockoutEnd > DateTimeOffset.UtcNow;
                    <tr>
                        <td>
                            @usuario.Email
                            @if (bloqueado)
                            {
                                <span class="badge bg-danger ms-1">Bloqueado</span>
                            }
                        </td>
                        <td>@usuario.PhoneNumber</td>
                        <td><span class="badge bg-@(item.Rol == BusinessType.Roles.Admin ? "dark" : "info")">@(item.Rol ?? "Sin rol")</span></td>
                        <td>@usuario.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@usuario.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
