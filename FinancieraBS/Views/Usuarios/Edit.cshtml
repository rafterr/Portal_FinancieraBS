@model FinancieraBS.Models.UsuarioFormViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-4">
    <h2>Editar Usuario</h2>

    <form asp-action="Edit" method="post" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />
        <small class="text-muted">Deje la contraseña en blanco para conservar la actual.</small>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Actualizar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
