@model FinancieraBS.Models.PrestamosIndexViewModel

@{
    ViewData["Title"] = "Préstamos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>
            Préstamos
            @if (Model.ClienteNombre != null)
            {
                <small class="text-muted">de @Model.ClienteNombre</small>
            }
        </h2>
        <a asp-action="Create" asp-route-clienteId="@Model.ClienteId" class="btn btn-primary">Nuevo Préstamo</a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-3" role="search">
        @if (Model.ClienteId.HasValue)
        {
            <input type="hidden" name="clienteId" value="@Model.ClienteId" />
        }
        else
        {
            <div class="col-md-6">
                <input type="search" name="q" value="@Model.Q" class="form-control" placeholder="Cliente, teléfono o #préstamo" aria-label="Buscar préstamo" />
            </div>
        }
        <div class="col-md-3">
            <select name="estatus" class="form-select" aria-label="Estatus">
                <option value="">Todos los estatus</option>
                <option value="EnProceso" selected="@(Model.Estatus == BusinessType.EstatusPrestamo.EnProceso)">En Proceso</option>
                <option value="Retraso" selected="@(Model.Estatus == BusinessType.EstatusPrestamo.Retraso)">Retraso</option>
                <option value="Pagado" selected="@(Model.Estatus == BusinessType.EstatusPrestamo.Pagado)">Pagado</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Filtrar</button>
            @if (!string.IsNullOrWhiteSpace(Model.Q) || Model.Estatus.HasValue || Model.ClienteId.HasValue)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Ver todos</a>
            }
        </div>
    </form>

    @if (Model.Prestamos.Count == 0)
    {
        <div class="alert alert-light border">No se encontraron préstamos.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle table-cards">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>Monto</th>
                        <th>Interés</th>
                        <th>Total</th>
                        <th>Saldo</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Estatus</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prestamo in Model.Prestamos)
                    {
                        <tr>
                            <td data-label="Préstamo" class="fw-semibold"><a asp-action="Detalle" asp-route-id="@prestamo.Id">#@prestamo.Id</a></td>
                            <td data-label="Cliente">@(prestamo.Cliente?.NombreCompleto ?? "N/A")</td>
                            <td data-label="Monto">$@prestamo.MontoSolicitado.ToString("N2")</td>
                            <td data-label="Interés">@prestamo.Interes%</td>
                            <td data-label="Total">$@prestamo.Total.ToString("N2")</td>
                            <td data-label="Saldo">$@prestamo.SaldoRestante.ToString("N2")</td>
                            <td data-label="Fecha inicio">@prestamo.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td data-label="Fecha fin">@prestamo.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td data-label="Estatus"><partial name="_EstatusBadge" model="prestamo.Estatus" /></td>
                            <td class="text-nowrap acciones">
                                <a asp-action="Detalle" asp-route-id="@prestamo.Id" class="btn btn-sm btn-info text-white">Ver</a>
                                @if (prestamo.Estatus != BusinessType.EstatusPrestamo.Pagado)
                                {
                                    <a asp-controller="Pagos" asp-action="Create" asp-route-prestamoId="@prestamo.Id" class="btn btn-sm btn-success">Pagar</a>
                                }
                                <a asp-action="Edit" asp-route-id="@prestamo.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@prestamo.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
