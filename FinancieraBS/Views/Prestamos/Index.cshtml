@model List<BusinessType.Prestamo>

@{
    ViewData["Title"] = "Préstamos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Préstamos</h2>
        <a asp-action="Create" class="btn btn-primary">Nuevo Préstamo</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Cliente</th>
                    <th>Monto</th>
                    <th>Interés</th>
                    <th>Total</th>
                    <th>Saldo</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Estatus</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prestamo in Model)
                {
                    <tr>
                        <td>@prestamo.Id</td>
                        <td>@(prestamo.Cliente?.NombreCompleto ?? "N/A")</td>
                        <td>$@prestamo.MontoSolicitado.ToString("N2")</td>
                        <td>@prestamo.Interes%</td>
                        <td>$@prestamo.Total.ToString("N2")</td>
                        <td>$@prestamo.SaldoRestante.ToString("N2")</td>
                        <td>@prestamo.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@prestamo.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>
                            @{
                                var badgeClass = prestamo.Estatus switch
                                {
                                    BusinessType.EstatusPrestamo.Pagado => "success",
                                    BusinessType.EstatusPrestamo.EnProceso => "primary",
                                    BusinessType.EstatusPrestamo.Retraso => "danger",
                                    _ => "secondary"
                                };
                            }
                            <span class="badge bg-@badgeClass">@Html.DisplayFor(_ => prestamo.Estatus)</span>
                        </td>
                        <td>
                            @if (prestamo.Estatus != BusinessType.EstatusPrestamo.Pagado)
                            {
                                <a asp-controller="Pagos" asp-action="Create" asp-route-prestamoId="@prestamo.Id" class="btn btn-sm btn-success">Pagar</a>
                            }
                            <a asp-action="Edit" asp-route-id="@prestamo.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@prestamo.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
