@model BusinessType.Prestamo

@{
    ViewData["Title"] = "Editar Préstamo";
}

<div class="container mt-4">
    <h2>Editar Préstamo #@Model.Id</h2>

    <form asp-action="Edit" method="post" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ClienteId" class="form-label"></label>
                <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.Clientes">
                    <option value="">Seleccione un cliente</option>
                </select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="MontoSolicitado" class="form-label"></label>
                <input asp-for="MontoSolicitado" type="number" step="0.01" min="1" class="form-control" />
                <span asp-validation-for="MontoSolicitado" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="FechaInicio" class="form-label"></label>
                <input asp-for="FechaInicio" type="date" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Interes" class="form-label"></label>
                <input asp-for="Interes" type="number" step="0.01" min="0" max="100" class="form-control" />
                <span asp-validation-for="Interes" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Estatus" class="form-label">Estatus</label>
                @if (Model.Estatus == BusinessType.EstatusPrestamo.Pagado)
                {
                    <input type="hidden" asp-for="Estatus" />
                    <input class="form-control" value="Pagado" disabled />
                }
                else
                {
                    <select asp-for="Estatus" class="form-select">
                        <option value="@BusinessType.EstatusPrestamo.EnProceso">En Proceso</option>
                        <option value="@BusinessType.EstatusPrestamo.Retraso">Retraso</option>
                    </select>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Total</label>
                <input class="form-control" value="$@Model.Total.ToString("N2")" disabled />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Saldo Restante</label>
                <input class="form-control" value="$@Model.SaldoRestante.ToString("N2")" disabled />
                <small class="text-muted">Se calcula automáticamente con los pagos registrados.</small>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Actualizar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>

    <partial name="_Documentos" model="ViewBag.Documentos" />
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
