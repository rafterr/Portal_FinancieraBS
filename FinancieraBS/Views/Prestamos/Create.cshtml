@model BusinessType.Prestamo

@{
    ViewData["Title"] = "Nuevo Préstamo";
}

<div class="container mt-4">
    <h2>Nuevo Préstamo</h2>
    
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="mt-4">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ClienteId" class="form-label">Cliente</label>
                <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.Clientes" required>
                    <option value="">Seleccione un cliente</option>
                </select>
            </div>
            
            <div class="col-md-6 mb-3">
                <label asp-for="MontoSolicitado" class="form-label">Monto Solicitado</label>
                <input asp-for="MontoSolicitado" type="number" step="0.01" class="form-control" required />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FechaInicio" class="form-label">Fecha de Inicio</label>
                <input asp-for="FechaInicio" type="date" class="form-control" required />
            </div>
            
            <div class="col-md-6 mb-3">
                <label asp-for="Interes" class="form-label">Interés (%)</label>
                <input asp-for="Interes" type="number" step="0.01" class="form-control" required />
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header bg-info text-white">
                Documentación del Préstamo
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="pagareFile" class="form-label">Pagaré</label>
                        <input type="file" name="pagareFile" id="pagareFile" class="form-control" accept="image/*,.pdf" />
                        <small class="text-muted">Formatos: JPG, PNG, PDF</small>
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label for="ineFile" class="form-label">INE del Cliente</label>
                        <input type="file" name="ineFile" id="ineFile" class="form-control" accept="image/*,.pdf" />
                        <small class="text-muted">Formatos: JPG, PNG, PDF</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Guardar Préstamo</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
