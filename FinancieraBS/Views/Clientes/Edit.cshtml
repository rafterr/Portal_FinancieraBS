@model BusinessType.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container mt-4">
    <h2>Editar Cliente</h2>
    
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="mt-4">
        <input type="hidden" asp-for="Id" />
        
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" required />
            </div>
            
            <div class="col-md-6 mb-3">
                <label asp-for="Apellidos" class="form-label">Apellidos</label>
                <input asp-for="Apellidos" class="form-control" required />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Telefono" class="form-label">Teléfono</label>
                <input asp-for="Telefono" class="form-control" required />
            </div>
            
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" required />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Direccion" class="form-label">Dirección</label>
            <textarea asp-for="Direccion" class="form-control" rows="2" required></textarea>
        </div>

        <div class="mb-3">
            <label for="comprobanteDomicilioFile" class="form-label">Comprobante de Domicilio</label>
            <input type="file" name="comprobanteDomicilioFile" id="comprobanteDomicilioFile" class="form-control" accept="image/*,.pdf" />
            @if (!string.IsNullOrEmpty(Model.ComprobanteDomicilioPath))
            {
                <small class="text-muted">Archivo actual: <a href="@Model.ComprobanteDomicilioPath" target="_blank">Ver</a></small>
            }
        </div>

        <div class="mb-3">
            <label asp-for="Estatus" class="form-label">Estatus</label>
            <select asp-for="Estatus" class="form-select">
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
            </select>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Actualizar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
