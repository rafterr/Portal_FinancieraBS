@model FinancieraBS.Models.ClientesIndexViewModel

@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Clientes</h2>
        <a asp-action="Create" class="btn btn-primary">Nuevo Cliente</a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-3" role="search">
        <div class="col-md-8">
            <input type="search" name="q" value="@Model.Q" class="form-control" autofocus
                   placeholder="Nombre, apellidos, teléfono o correo" aria-label="Buscar cliente" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Q))
    {
        <p class="text-muted">@Model.Clientes.Count resultado(s) para "<strong>@Model.Q</strong>"</p>
    }

    @if (Model.Clientes.Count == 0)
    {
        <div class="alert alert-light border">
            @(string.IsNullOrWhiteSpace(Model.Q) ? "Todavía no hay clientes registrados." : "No se encontraron clientes con esa búsqueda.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle table-cards">
                <thead class="table-dark">
                    <tr>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Préstamos activos</th>
                        <th>Estatus</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in Model.Clientes)
                    {
                        var activos = cliente.Prestamos.Count(p => p.Estatus != BusinessType.EstatusPrestamo.Pagado);
                        <tr>
                            <td data-label="Cliente" class="fw-semibold">@cliente.NombreCompleto</td>
                            <td data-label="Teléfono"><a href="tel:@cliente.Telefono">@cliente.Telefono</a></td>
                            <td data-label="Email">@cliente.Email</td>
                            <td data-label="Préstamos activos">
                                <span>
                                @if (activos > 0)
                                {
                                    <span class="badge bg-primary">@activos</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                                <small class="text-muted">de @cliente.Prestamos.Count</small>
                                </span>
                            </td>
                            <td data-label="Estatus">
                                <span class="badge bg-@(cliente.Estatus == "Activo" ? "success" : "secondary")">
                                    @cliente.Estatus
                                </span>
                            </td>
                            <td class="text-nowrap acciones">
                                <a asp-controller="Prestamos" asp-action="Index" asp-route-clienteId="@cliente.Id" class="btn btn-sm btn-info text-white">Préstamos</a>
                                <a asp-controller="Prestamos" asp-action="Create" asp-route-clienteId="@cliente.Id" class="btn btn-sm btn-outline-primary">+ Préstamo</a>
                                <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
